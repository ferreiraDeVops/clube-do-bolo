const gallery = root.querySelector('#gallery-sections');
function keyboardCarouselIndex(key, index, count) {
  if (key === 'ArrowRight') return Math.min(index + 1, count - 1);
  if (key === 'ArrowLeft') return Math.max(index - 1, 0);
  if (key === 'Home') return 0;
  if (key === 'End') return count - 1;
  return null;
}
categories.forEach((category, categoryIndex) => {
  const section = document.createElement('section');
  section.className = 'display-section';
  const isShowcase = categoryOrder.includes(category.id);
  if (isShowcase) section.classList.add('confected-showcase');
  section.id = category.id;
  const kicker = isShowcase ? '' : `<div class="section-kicker">${String(categoryIndex + 1).padStart(2, '0')} / vitrine</div>`;
  section.innerHTML = `<div class="section-heading"><div>${kicker}<h2>${category.title}</h2></div><p>${category.description}</p></div><div class="product-grid" id="${category.id}-images"></div>${isShowcase ? '<div class="carousel-dots" role="group" aria-label="Navegação de imagens"></div>' : ''}`;
  const grid = section.querySelector('.product-grid');
  category.files.forEach((file, index) => {
    const figure = document.createElement('figure');
    figure.className = 'product-card';
    const caption = isShowcase ? 'clube do bolo' : category.title;
    const source = `${category.originalFiles?.includes(file) ? '' : (category.basePath ?? 'optimized/')}${category.folder}/${file}`;
    figure.innerHTML = `<img alt="${category.title} clube do bolo ${index + 1}" loading="lazy" decoding="async"><figcaption>${caption}</figcaption>`;
    const photo = figure.querySelector('img');
    if (productImageObserver) {
      photo.dataset.source = source;
      productImageObserver.observe(photo);
    } else applyImageAsset(photo, source, '(max-width: 768px) 86vw, 330px');
    grid.appendChild(figure);
  });
  gallery.appendChild(section);
  if (isShowcase) {
    const dots = section.querySelector('.carousel-dots');
    let positions = [];
    let previousActiveDot = -1;
    const updateActiveDot = () => {
      let active = 0;
      positions.forEach((position, index) => {
        if (Math.abs(position - grid.scrollLeft) < Math.abs(positions[active] - grid.scrollLeft)) active = index;
      });
      if (active === previousActiveDot) return;
      const visibleStart = Math.max(0, Math.min(active - 1, positions.length - 3));
      const oldOffsets = new Map(Array.from(dots.children)
        .filter((dot) => !dot.hidden)
        .map((dot) => [dot, dot.offsetLeft]));
      Array.from(dots.children).forEach((dot, index) => {
        dot.hidden = index < visibleStart || index >= visibleStart + 3;
        dot.classList.toggle('active', index === active);
        dot.setAttribute('aria-current', String(index === active));
      });
      if (previousActiveDot >= 0 && active !== previousActiveDot &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const direction = active > previousActiveDot ? 1 : -1;
        Array.from(dots.children).filter((dot) => !dot.hidden).forEach((dot) => {
          const entering = !oldOffsets.has(dot);
          const distance = entering ? direction * 48 : oldOffsets.get(dot) - dot.offsetLeft;
          const isActive = dot === dots.children[active];
          const startX = distance || direction * 12;
          dot.getAnimations().forEach((animation) => animation.cancel());
          dot.animate([
            { transform: `translateX(${startX}px) scale(${entering ? .45 : 1})`, opacity: entering ? 0 : 1, offset: 0 },
            { transform: `translateX(${-direction * 7}px) scale(${isActive ? 1.3 : 1.05})`, opacity: 1, offset: .55 },
            { transform: `translateX(${direction * 3}px) scale(${isActive ? .94 : 1})`, opacity: 1, offset: .8 },
            { transform: "translateX(0) scale(" + (isActive ? 1.5 : 1) + ")", opacity: 1, offset: 1 },
          ], { duration: 560, easing: 'ease-out', pseudoElement: '::before' });
        });
      }
      previousActiveDot = active;
      if (dots.contains(document.activeElement) && document.activeElement.hidden) {
        dots.children[active]?.focus({ preventScroll: true });
      }
    };
    const updateDots = () => {
      const maxScroll = Math.max(0, grid.scrollWidth - grid.clientWidth);
      const first = grid.querySelector('.product-card');
      positions = [];
      grid.querySelectorAll('.product-card').forEach((card) => {
        const position = Math.min(maxScroll, card.offsetLeft - first.offsetLeft);
        if (!positions.length || position - positions[positions.length - 1] > 2) positions.push(position);
      });
      if (dots.children.length !== positions.length) {
        dots.replaceChildren();
        positions.forEach((position, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', `${category.title}: posição ${index + 1}`);
          dot.setAttribute('aria-controls', grid.id);
          dot.addEventListener('click', () => grid.scrollTo({
            left: positions[index],
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          }));
          dots.appendChild(dot);
        });
      }
      dots.hidden = maxScroll <= 2;
      previousActiveDot = -1;
      updateActiveDot();
    };
    let dotFramePending = false;
    const scheduleDotUpdate = () => {
      if (dotFramePending) return;
      dotFramePending = true;
      requestAnimationFrame(() => {
        updateActiveDot();
        dotFramePending = false;
      });
    };
    grid.addEventListener('scroll', scheduleDotUpdate, { passive: true });
    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(updateDots);
      resizeObserver.observe(grid);
      resizeObserver.observe(grid.querySelector('.product-card'));
    } else {
      window.addEventListener('resize', updateDots);
    }
    dots.addEventListener('keydown', (event) => {
      const index = Array.from(dots.children).indexOf(event.target);
      if (index < 0) return;
      const targetIndex = keyboardCarouselIndex(event.key, index, positions.length);
      if (targetIndex === null) return;
      event.preventDefault();
      // Update the visible dot window before moving keyboard focus.
      grid.scrollTo({ left: positions[targetIndex], behavior: 'instant' });
      updateActiveDot();
      dots.children[targetIndex]?.focus({ preventScroll: true });
    });
    updateDots();
  }
});

